#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6.0", "jsonschema>=4.18"]
# ///
"""fab0-resolve: the deterministic resolver of fab0.

Commands, each printing one JSON object:

  validate            check the project's .fab0/ wiring
  next RUN            compute what run RUN needs next: a stage, a gate, an action,
                      runnable tasks, wait, done or blocked
  record RUN STAGE    validate an agent's return, verify the outputs, check the
                      write scope and write the ledger entry
  inbox               what every open run needs, for one user (read-only)

Exit codes: 0 ok, 1 error, 2 usage, 3 invalid wiring, 4 refused.

The resolver reads GitHub through `gh` and never writes to it. It writes only
ledger entries (work/{run}/ledger/) and its pending hand-outs under the home
repo's git directory. Set FAB0_GH_FAKE=<file.json> to read GitHub facts from a
JSON file instead (used by the tests).
"""

from __future__ import annotations

import argparse
import copy
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import urllib.parse
from pathlib import Path

import jsonschema
import yaml

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
SCHEMAS = PLUGIN_ROOT / "schemas"

MANIFEST = PLUGIN_ROOT / ".claude-plugin" / "plugin.json"

EXIT_OK, EXIT_ERROR, EXIT_USAGE, EXIT_INVALID, EXIT_REFUSED = 0, 1, 2, 3, 4
HARNESS = "claude-code"
MAX_REWORK = 2  # re-runs after an agent gate's reject; the next reject escalates to a human
REVIEW_STATES = ("CHANGES_REQUESTED", "COMMENTED")
BASE, WORKTREE, BRANCH = "base", "worktree", "branch"


class Fail(Exception):
    """Stops a command with an exit code and a JSON payload."""

    def __init__(self, code: int, error: str, **detail):
        super().__init__(error)
        self.code = code
        self.payload = {"error": error, **detail}


# ---------------------------------------------------------------- hashing, text


def sha(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def sha_json(obj) -> str:
    return sha(json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode())


def sha_text(text: str) -> str:
    return sha(text.replace("\r\n", "\n").encode())


def sha_content(content) -> str | None:
    """Hash a file (bytes) or a directory (dict of relative path to bytes)."""
    if content is None:
        return None
    if isinstance(content, bytes):
        return sha(content)
    return sha("".join(f"{p}\0{sha(b)}\n" for p, b in sorted(content.items())).encode())


EMPTY_REVIEWS = sha_json([])


def slugify(text: str, limit: int = 40) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:limit].rstrip("-") or "item"


def quote_block(text: str) -> str:
    return "\n".join("> " + line if line else ">" for line in (text or "(empty)").splitlines())


INLINE_LIMIT = 64 * 1024  # text inputs up to this size are put in the brief, so agents need no git to read them
FENCE_LANG = {"markdown": "markdown", "yaml": "yaml", "json": "json", "gherkin": "gherkin", "openapi": "yaml"}


def inline_text(content) -> str | None:
    if not isinstance(content, bytes) or len(content) > INLINE_LIMIT:
        return None
    try:
        return content.decode()
    except UnicodeDecodeError:
        return None


def tail(text: str, lines: int = 20) -> str:
    return "\n".join(text.strip().splitlines()[-lines:])


# ---------------------------------------------------------------- version


def read_version(manifest: Path | None = None) -> str:
    """The release of the plugin this resolver belongs to, from its manifest; reads nothing else."""
    manifest = manifest or MANIFEST
    try:
        data = json.loads(manifest.read_text())
    except OSError as e:
        raise Fail(EXIT_ERROR, f"cannot read the plugin manifest {manifest}: {e.strerror or e}") from None
    except ValueError as e:
        raise Fail(EXIT_ERROR, f"the plugin manifest {manifest} is not valid JSON: {e}") from None
    version = data.get("version") if isinstance(data, dict) else None
    if not isinstance(version, str) or not version.strip():
        raise Fail(EXIT_ERROR, f"the plugin manifest {manifest} has no non-empty string `version`")
    return version


def cmd_version(args) -> dict:
    return {"ok": True, "fab0_version": read_version()}


# ---------------------------------------------------------------- schemas

_schemas: dict[Path, dict] = {}


def load_schema(path: Path) -> dict:
    path = path.resolve()
    if path not in _schemas:
        _schemas[path] = json.loads(path.read_text())
    return _schemas[path]


def core_schema(name: str) -> dict:
    return load_schema(SCHEMAS / name)


def schema_errors(instance, schema: dict) -> list[str]:
    validator = jsonschema.Draft202012Validator(schema)
    out = []
    for err in sorted(validator.iter_errors(instance), key=lambda e: [str(p) for p in e.absolute_path]):
        if err.context:
            err = jsonschema.exceptions.best_match(err.context)
        where = "/".join(str(p) for p in err.absolute_path) or "(root)"
        out.append(f"{where}: {err.message}")
    return out


def resolve_schema_ref(ref: str, root: Path) -> Path:
    """`fab0:schemas/x.json` is this plugin's; anything without a prefix is project-relative."""
    if ":" in ref:
        plugin, rel = ref.split(":", 1)
        if plugin != "fab0":
            raise ValueError(f"schema '{ref}': only fab0: and project-relative schema paths resolve for now")
        return PLUGIN_ROOT / rel
    return root / ref


def return_extensions() -> dict:
    return core_schema("return.json")["$defs"]["extensions"]


def merge_patch(target, patch):
    """RFC 7396 JSON Merge Patch."""
    if not isinstance(patch, dict):
        return copy.deepcopy(patch)
    result = copy.deepcopy(target) if isinstance(target, dict) else {}
    for key, value in patch.items():
        if value is None:
            result.pop(key, None)
        else:
            result[key] = merge_patch(result.get(key), value)
    return result


# ---------------------------------------------------------------- wiring


class Wiring:
    """The project's .fab0/ files, loaded and checked."""

    def __init__(self, root: Path, profile: str | None = None):
        self.root = root
        self.errors: list[dict] = []
        self.project = self._load_file("fab0.yaml", "fab0.json") or {}
        self.artifacts = self._load_dir("artifacts", "artifact.json", "artifact")
        self.stages = self._load_dir("stages", "stage.json", "stage")
        self.pipelines = self._load_dir("pipelines", "pipeline.json", "pipeline")
        if self.project and not self.errors:
            self._check()
        if self.project and profile is not None and not self.errors:
            self._apply_profile(profile)

    def error(self, where: str, message: str) -> None:
        self.errors.append({"file": where, "message": message})

    def _load_file(self, rel: str, schema_name: str):
        path = self.root / ".fab0" / rel
        where = f".fab0/{rel}"
        if not path.is_file():
            self.error(where, "missing")
            return None
        try:
            data = yaml.safe_load(path.read_text())
        except yaml.YAMLError as exc:
            self.error(where, f"invalid YAML: {exc}")
            return None
        errors = schema_errors(data, core_schema(schema_name))
        for message in errors:
            self.error(where, message)
        return None if errors else data

    def _load_dir(self, sub: str, schema_name: str, key: str) -> dict:
        out = {}
        folder = self.root / ".fab0" / sub
        if not folder.is_dir():
            return out
        for path in sorted(folder.iterdir()):
            if path.suffix == ".yml":
                self.error(f".fab0/{sub}/{path.name}", "use the .yaml extension")
            if path.suffix != ".yaml":
                continue
            data = self._load_file(f"{sub}/{path.name}", schema_name)
            if data is None:
                continue
            if data[key] != path.stem:
                self.error(f".fab0/{sub}/{path.name}", f"{key} '{data[key]}' doesn't match the file name")
                continue
            out[data[key]] = data
        return out

    def _apply_profile(self, name: str) -> None:
        profiles = self.project.get("profiles", {})
        if name not in profiles:
            self.error(".fab0/fab0.yaml", f"no profile '{name}'")
            return
        self.project = merge_patch(self.project, profiles[name])

    def _check_agent(self, where: str, field: str, agent: str) -> None:
        if ":" not in agent and not (self.root / ".claude" / "agents" / f"{agent}.md").is_file():
            self.error(where, f"{field}: '{agent}' is neither plugin:name nor a file in .claude/agents/")

    def _check(self) -> None:
        p = self.project
        repos, people = p["repos"], p["people"]
        classes = set(p["models"][HARNESS])
        f0 = ".fab0/fab0.yaml"

        keys: dict[str, str] = {}
        for name, repo in repos.items():
            if repo["owner"] not in people:
                self.error(f0, f"repos.{name}.owner: no role '{repo['owner']}' in people")
            if "key" in repo:
                if repo["key"] in keys:
                    self.error(f0, f"repos.{name}.key: '{repo['key']}' is also the key of {keys[repo['key']]}")
                keys[repo["key"]] = name
        for name in p["pipelines"]:
            if name not in self.pipelines:
                self.error(f0, f"pipelines: no pipeline '{name}' in .fab0/pipelines/")
        for name, patch in p.get("profiles", {}).items():
            for message in schema_errors(merge_patch(p, patch), core_schema("fab0.json")):
                self.error(f0, f"profiles.{name} makes the file invalid: {message}")

        for name, art in self.artifacts.items():
            where = f".fab0/artifacts/{name}.yaml"
            loc = art["location"]
            if "repo" in loc and loc["repo"] not in repos and loc["repo"] != "task":
                self.error(where, f"location.repo: no repo '{loc['repo']}' in fab0.yaml")
            if loc.get("github") == "pr":
                self.error(where, "location github: pr is not supported yet")
            if "{task}" in loc.get("path", "") and loc.get("repo") != "task":
                self.error(where, "location.path: {task} needs repo: task")
            if "schema" in art:
                if art["format"] not in ("yaml", "json"):
                    self.error(where, "schema: only yaml and json artifacts have a schema")
                    continue
                try:
                    path = resolve_schema_ref(art["schema"], self.root)
                except ValueError as exc:
                    self.error(where, str(exc))
                    continue
                if not path.is_file():
                    self.error(where, f"schema: {art['schema']} not found")
                    continue
                try:
                    jsonschema.Draft202012Validator.check_schema(load_schema(path))
                except (json.JSONDecodeError, jsonschema.SchemaError) as exc:
                    self.error(where, f"schema: {art['schema']} is not a valid JSON Schema: {exc}")

        for name, stage in self.stages.items():
            where = f".fab0/stages/{name}.yaml"
            for io in ("inputs", "outputs"):
                for art in stage.get(io, []):
                    if art not in self.artifacts:
                        self.error(where, f"{io}: no artifact type '{art}'")
            for art in stage.get("outputs", []):
                if "github" in self.artifacts.get(art, {}).get("location", {}):
                    self.error(where, f"outputs: '{art}' is read from GitHub and can't be written by a stage")
            for io in ("write", "read"):
                for repo in stage.get("repos", {}).get(io, []):
                    if repo not in repos and repo != "task" and not (io == "read" and repo == "all"):
                        self.error(where, f"repos.{io}: no repo '{repo}' in fab0.yaml")
            if "agent" in stage:
                self._check_agent(where, "agent", stage["agent"])
                for key in ("model", "owner"):
                    if key not in stage:
                        self.error(where, f"an agent stage needs '{key}'")
                if "model" in stage and stage["model"] not in classes:
                    self.error(where, f"model: no class '{stage['model']}' in models.{HARNESS}")
                if "owner" in stage and stage["owner"] not in people and stage["owner"] != "repo-owner":
                    self.error(where, f"owner: no role '{stage['owner']}' in people")
                for key in stage.get("return", {}):
                    if key not in return_extensions():
                        self.error(
                            where, f"return: '{key}' is not a known return field ({', '.join(return_extensions())})"
                        )
                gate = stage.get("gate", "none")
                if isinstance(gate, dict):
                    self._check_agent(where, "gate.agent", gate["agent"])
                    if gate["model"] not in classes:
                        self.error(where, f"gate.model: no class '{gate['model']}' in models.{HARNESS}")
            else:
                for key in ("model", "owner", "skills", "return", "outputs", "repos"):
                    if key in stage:
                        self.error(where, f"an action stage takes no '{key}'")
                if isinstance(stage.get("gate"), dict):
                    self.error(where, "gate: an action stage can't have an agent gate")
                inputs = stage.get("inputs", [])
                formats = [self.artifacts.get(a, {}).get("format") for a in inputs]
                if stage["action"] == "plan" and (len(inputs) != 1 or formats[0] not in ("yaml", "json")):
                    self.error(where, "plan takes exactly one input: the yaml or json task list")
                if stage["action"] == "deliver" and (len(inputs) != 1 or formats[0] != "markdown"):
                    self.error(
                        where,
                        "deliver takes exactly one input: the markdown document the review results are appended to",
                    )

        types: dict[str, str] = {}
        for name, pipeline in self.pipelines.items():
            self._check_pipeline(name, pipeline, types)

    def _check_pipeline(self, name: str, pipeline: dict, types: dict) -> None:
        where = f".fab0/pipelines/{name}.yaml"
        issue_type = pipeline["item"]["issue_type"]
        if name in self.project["pipelines"]:
            if issue_type in types:
                self.error(where, f"item.issue_type: {issue_type} also runs pipeline {types[issue_type]}")
            types[issue_type] = name
        for key in ("inputs", "outputs"):
            if key in pipeline:
                self.error(where, f"{key}: pipeline inputs and outputs (nested pipelines) are not supported yet")

        steps = pipeline["stages"]
        first_written: dict[str, int] = {}  # artifact → index of the first step that writes it
        for i, step in enumerate(steps):
            for stage_name in self._stage_names([step]):
                for art in self.stages.get(stage_name, {}).get("outputs", []):
                    first_written.setdefault(art, i)
        seen: set[str] = set()
        foreach_arts: list[str] = []
        for i, step in enumerate(steps):
            at = f"stages[{i}]"
            if isinstance(step, dict) and "foreach" in step:
                for key in ("call", "when", "inputs"):
                    if key in step:
                        self.error(where, f"{at}: '{key}' is not supported yet")
                if "stages" not in step:
                    self.error(where, f"{at}: foreach needs stages")
                    continue
                art = step["foreach"].split(".")[0]
                if art not in self.artifacts:
                    self.error(where, f"{at}: foreach: no artifact type '{art}'")
                elif self.artifacts[art]["format"] not in ("yaml", "json"):
                    self.error(where, f"{at}: foreach reads only yaml or json artifacts")
                foreach_arts.append(art)
                names, in_each = step["stages"], True
            else:
                if isinstance(step, dict):
                    if "when" in step:
                        self.error(where, f"{at}: 'when' is not supported yet")
                    step = step["stage"]
                names, in_each = [step], False
            for stage_name in names:
                stage = self.stages.get(stage_name)
                if stage is None:
                    self.error(where, f"{at}: no stage '{stage_name}'")
                    continue
                if stage_name in seen:
                    self.error(where, f"{at}: stage '{stage_name}' appears twice")
                seen.add(stage_name)
                if in_each and "agent" not in stage:
                    self.error(where, f"{at}: foreach runs agent stages only; '{stage_name}' is an action")
                if not in_each:
                    if stage.get("owner") == "repo-owner":
                        self.error(where, f"{at}: '{stage_name}' has owner repo-owner, which needs a foreach element")
                    scoped = stage.get("repos", {}).get("write", []) + stage.get("repos", {}).get("read", [])
                    if "task" in scoped:
                        self.error(where, f"{at}: '{stage_name}' names repo 'task', which needs a foreach element")
                    for art in stage.get("outputs", []):
                        if self.artifacts.get(art, {}).get("location", {}).get("repo") == "task":
                            self.error(
                                where,
                                f"{at}: '{stage_name}' writes '{art}' to repo 'task', which needs a foreach element",
                            )
                if stage.get("action") == "deliver" and i != len(steps) - 1:
                    self.error(where, f"{at}: deliver must be the last stage")
                for art in stage.get("inputs", []):
                    if first_written.get(art, -1) > i:
                        self.error(where, f"{at}: '{stage_name}' reads '{art}' before the stage that writes it")
        for i, step in enumerate(steps):
            stage_name = step if isinstance(step, str) else step.get("stage")
            stage = self.stages.get(stage_name or "", {})
            if stage.get("action") == "plan":
                art = stage["inputs"][0]
                if art not in foreach_arts:
                    self.error(where, f"stages[{i}]: plan reads '{art}', but no later foreach runs over it")

    @staticmethod
    def _stage_names(steps) -> list[str]:
        out = []
        for step in steps:
            if isinstance(step, str):
                out.append(step)
            elif "stage" in step:
                out.append(step["stage"])
            else:
                out.extend(step.get("stages", []))
        return out


# ---------------------------------------------------------------- tasks


def task_rules(tasks: list, repos) -> list[str]:
    """Rules on a task list beyond its schema: unique ids, known repos, acyclic depends_on."""
    errors = []
    ids = [t["id"] for t in tasks]
    dup = sorted({i for i in ids if ids.count(i) > 1})
    if dup:
        errors.append(f"duplicate task ids: {', '.join(dup)}")
    known = set(ids)
    for t in tasks:
        if t["repo"] not in repos:
            errors.append(f"{t['id']}: repo '{t['repo']}' is not in fab0.yaml")
        for dep in t.get("depends_on", []):
            if dep not in known:
                errors.append(f"{t['id']}: depends_on {dep}, which is not a task")
    graph: dict[str, list[str]] = {}
    for t in tasks:
        graph.setdefault(t["id"], []).extend(d for d in t.get("depends_on", []) if d in known)
    finished: set[str] = set()

    def cycle_from(node: str, path: list[str]) -> list[str] | None:
        if node in path:
            return path[path.index(node) :] + [node]
        if node in finished:
            return None
        for nxt in graph[node]:
            found = cycle_from(nxt, path + [node])
            if found:
                return found
        finished.add(node)
        return None

    for node in graph:
        found = cycle_from(node, [])
        if found:
            errors.append("depends_on has a cycle: " + " → ".join(found))
            break
    return errors


def lanes(tasks: list) -> list[list[str]]:
    """Group tasks that can't run in parallel: same repo and overlapping files, or ordered by depends_on.

    Tasks in different lanes can run at once; tasks in one lane run one after another.
    A path ending in / covers everything under it.
    """
    parent = {t["id"]: t["id"] for t in tasks}

    def find(x: str) -> str:
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def overlap(f: str, g: str) -> bool:
        f, g = f.rstrip("/"), g.rstrip("/")
        return f == g or f.startswith(g + "/") or g.startswith(f + "/")

    for i, a in enumerate(tasks):
        for b in tasks[i + 1 :]:
            same_files = a["repo"] == b["repo"] and any(overlap(f, g) for f in a["files"] for g in b["files"])
            ordered = b["id"] in a.get("depends_on", []) or a["id"] in b.get("depends_on", [])
            if same_files or ordered:
                parent[find(a["id"])] = find(b["id"])
    groups: dict[str, list[str]] = {}
    for t in tasks:
        groups.setdefault(find(t["id"]), []).append(t["id"])
    return list(groups.values())


# ---------------------------------------------------------------- verification


def verify_artifact(wiring: Wiring, art: dict, repo: Repo, path: str, content) -> list[str]:
    """Rungs 2 and 3 of the verification ladder: parse, schema, then the artifact's verifiers."""
    if content is None:
        return [f"{path} is missing"]
    errors = []
    fmt = art["format"]
    if fmt in ("yaml", "json"):
        try:
            data = json.loads(content) if fmt == "json" else yaml.safe_load(content)
        except (json.JSONDecodeError, yaml.YAMLError) as exc:
            return [f"{path}: not valid {fmt}: {exc}"]
        if "schema" in art:
            schema_path = resolve_schema_ref(art["schema"], wiring.root)
            errors += [f"{path}: {m}" for m in schema_errors(data, load_schema(schema_path))]
            if not errors and schema_path.resolve() == (SCHEMAS / "tasks.json").resolve():
                errors += [f"{path}: {m}" for m in task_rules(data, wiring.project["repos"])]
    for check in art.get("verify", []):
        if "sections" in check:
            if not isinstance(content, bytes):
                errors.append(f"{path}: sections apply to a file, not a directory")
                continue
            text = content.decode(errors="replace")
            heads = {m.group(1).strip() for m in re.finditer(r"^#{1,6}\s+(.+?)\s*#*\s*$", text, re.M)}
            missing = [s for s in check["sections"] if s not in heads]
            if missing:
                errors.append(f"{path}: missing sections: {', '.join(missing)}")
        elif "lint" in check:
            cmd = check["lint"].replace("{path}", shlex.quote(str(repo.path / path)))
            run = subprocess.run(cmd, shell=True, cwd=repo.path, capture_output=True, text=True)
            if run.returncode:
                errors.append(f"{path}: `{check['lint']}` failed: {tail(run.stdout + run.stderr)}")
        elif "script" in check:
            exe = shutil.which(check["script"])
            if exe is None:
                errors.append(f"{path}: verifier {check['script']} is not on PATH")
                continue
            run = subprocess.run([exe, str(repo.path / path)], cwd=repo.path, capture_output=True, text=True)
            if run.returncode:
                errors.append(f"{path}: {check['script']} failed: {tail(run.stdout + run.stderr)}")
    return errors


# ---------------------------------------------------------------- git


class Repo:
    """One repository of the workspace, read through git.

    A source is where something is read from: (BASE, None) is the base branch
    (origin/main when it is at or ahead of main), (WORKTREE, None) the files on
    disk, and (BRANCH, ref) a local or origin branch.
    """

    def __init__(self, name: str, cfg: dict, home_root: Path):
        self.name = name
        self.github = cfg["github"]
        self.owner = cfg["owner"]
        self.base = cfg.get("base", "main")
        self.path = (home_root / cfg["path"]).resolve()
        self._base_ref: str | None = None

    def exists(self) -> bool:
        return (self.path / ".git").exists()

    def _git(self, *args: str) -> subprocess.CompletedProcess:
        return subprocess.run(["git", "-C", str(self.path), *args], capture_output=True)

    def out(self, *args: str) -> str:
        run = self._git(*args)
        if run.returncode:
            raise Fail(EXIT_ERROR, f"git {' '.join(args)} failed in {self.name}: {run.stderr.decode().strip()}")
        return run.stdout.decode().strip()

    def ref_exists(self, ref: str) -> bool:
        return self._git("rev-parse", "--verify", "-q", f"{ref}^{{commit}}").returncode == 0

    @property
    def base_ref(self) -> str:
        if self._base_ref is None:
            local, remote = self.base, f"origin/{self.base}"
            has_local, has_remote = self.ref_exists(local), self.ref_exists(remote)
            if has_local and has_remote:
                ahead = self._git("merge-base", "--is-ancestor", local, remote).returncode == 0
                self._base_ref = remote if ahead else local
            elif has_remote:
                self._base_ref = remote
            elif has_local:
                self._base_ref = local
            else:
                raise Fail(EXIT_ERROR, f"{self.name}: no branch {local} or {remote} in {self.path}")
        return self._base_ref

    def git_dir(self) -> Path:
        return Path(self.out("rev-parse", "--absolute-git-dir"))

    def current_branch(self) -> str | None:
        run = self._git("symbolic-ref", "--short", "-q", "HEAD")
        return run.stdout.decode().strip() if run.returncode == 0 else None

    def run_branches(self, run: str) -> list[str]:
        """Local, then origin, branches named {stage}/{run}-…; nested child runs are excluded."""
        pattern = re.compile(rf"^(origin/)?[a-z][a-z0-9-]*/{re.escape(run)}-(?![A-Z]{{2,3}}-\d)")
        refs = self.out("for-each-ref", "--format=%(refname:short)", "refs/heads", "refs/remotes/origin").splitlines()
        matching = [r for r in refs if pattern.match(r)]
        return [r for r in matching if not r.startswith("origin/")] + [r for r in matching if r.startswith("origin/")]

    def ref_for(self, src: tuple) -> str | None:
        kind, ref = src
        return self.base_ref if kind == BASE else ref if kind == BRANCH else None

    def map_source(self, src: tuple) -> tuple:
        """The same source in this repo: a branch of the same name, or the base."""
        kind, ref = src
        if kind != BRANCH:
            return src
        branch = ref.removeprefix("origin/")
        if self.ref_exists(branch):
            return (BRANCH, branch)
        if self.ref_exists(f"origin/{branch}"):
            return (BRANCH, f"origin/{branch}")
        if self.current_branch() == branch:
            return (WORKTREE, None)
        return (BASE, None)

    def read_file(self, src: tuple, path: str) -> bytes | None:
        if not self.exists():
            return None
        if src[0] == WORKTREE:
            file = self.path / path
            return file.read_bytes() if file.is_file() else None
        run = self._git("cat-file", "blob", f"{self.ref_for(src)}:{path}")
        return run.stdout if run.returncode == 0 else None

    def read_dir(self, src: tuple, path: str) -> dict | None:
        if not self.exists():
            return None
        root = path.rstrip("/")
        if src[0] == WORKTREE:
            folder = self.path / root
            if not folder.is_dir():
                return None
            files = {p.relative_to(folder).as_posix(): p.read_bytes() for p in folder.rglob("*") if p.is_file()}
            return files or None
        ref = self.ref_for(src)
        names = self._git("ls-tree", "-r", "-z", "--name-only", ref, "--", root + "/").stdout.decode().split("\0")
        files = {}
        for name in filter(None, names):
            files[name[len(root) + 1 :]] = self._git("cat-file", "blob", f"{ref}:{name}").stdout
        return files or None

    def read(self, src: tuple, path: str, fmt: str):
        return self.read_dir(src, path) if fmt == "dir" else self.read_file(src, path)

    def sources(self, run: str) -> list[tuple]:
        """Where a run's ledger entries can be: the base first, so a merged entry reads from the base."""
        return [(BASE, None), (WORKTREE, None)] + [(BRANCH, b) for b in self.run_branches(run)]

    def ledger(self, run: str) -> list[tuple[dict, tuple]]:
        if not self.exists():
            return []
        folder = f"work/{run}/ledger"
        schema = core_schema("ledger-entry.json")
        seen: dict[str, tuple[dict, tuple]] = {}
        for src in self.sources(run):
            if src[0] == WORKTREE:
                names = [p.name for p in (self.path / folder).glob("*.yaml")]
            else:
                listing = self._git("ls-tree", "-z", "--name-only", self.ref_for(src), "--", folder + "/")
                names = [Path(n).name for n in listing.stdout.decode().split("\0") if n.endswith(".yaml")]
            for name in names:
                if name in seen:
                    continue
                entry = yaml.safe_load(self.read_file(src, f"{folder}/{name}") or b"")
                errors = schema_errors(entry, schema)
                if errors or entry_name(entry) != name:
                    where = "the working tree" if src[0] == WORKTREE else self.ref_for(src)
                    raise Fail(
                        EXIT_ERROR,
                        f"invalid ledger entry {folder}/{name} on {where} in {self.name}",
                        errors=errors or [f"its name should be {entry_name(entry)}"],
                    )
                seen[name] = (entry, src)
        return list(seen.values())

    def scope_state(self) -> dict:
        """HEAD and a hash of every dirty file, to detect changes made while a stage ran."""
        if not self.exists():
            return {"absent": True}
        head = self._git("rev-parse", "-q", "--verify", "HEAD").stdout.decode().strip() or None
        status = self._git("status", "--porcelain=v1", "-z", "--untracked-files=all").stdout.decode()
        parts = status.split("\0")
        dirty = {}
        i = 0
        while i < len(parts):
            item = parts[i]
            i += 1
            if len(item) < 4:
                continue
            code, path = item[:2], item[3:]
            if "R" in code or "C" in code:
                i += 1  # the original path follows a rename or copy
            file = self.path / path
            dirty[path] = sha(file.read_bytes()) if file.is_file() else "deleted"
        return {"head": head, "dirty": dirty}


def scope_diff(before: dict, after: dict) -> list[str]:
    if before.get("absent") or after.get("absent"):
        return [] if before == after else ["the repository appeared or disappeared"]
    changes = []
    if before["head"] != after["head"]:
        changes.append(f"HEAD moved from {before['head']} to {after['head']}")
    for path in sorted(set(before["dirty"]) | set(after["dirty"])):
        if before["dirty"].get(path) != after["dirty"].get(path):
            changes.append(path)
    return changes


def entry_name(entry: dict) -> str:
    task = f"-{entry['task']}" if entry.get("task") else ""
    gate = "-gate" if "decision" in entry.get("gate", {}) else ""
    return f"{entry['stage']}{task}-{entry['attempt']}{gate}.yaml"


# ---------------------------------------------------------------- GitHub


def issue_ref(issue: dict | None) -> str | None:
    return f"{issue['repo']}#{issue['number']}" if issue else None


class GhCli:
    """GitHub facts through the person's own `gh` login. Read-only."""

    def _run(self, args: list[str]):
        run = subprocess.run(["gh", *args], capture_output=True, text=True)
        if run.returncode:
            raise Fail(EXIT_ERROR, f"gh {' '.join(args)} failed: {run.stderr.strip()}")
        return json.loads(run.stdout or "null")

    def _api(self, path: str, paginate: bool = False):
        if not paginate:
            return self._run(["api", path])
        return [item for page in self._run(["api", path, "--paginate", "--slurp"]) for item in page]

    @staticmethod
    def _issue(d: dict, repo: str | None = None) -> dict:
        repo = repo or d["repository_url"].split("/repos/", 1)[1]
        return {
            "repo": repo,
            "number": d["number"],
            "title": d["title"],
            "body": d.get("body") or "",
            "type": (d.get("type") or {}).get("name"),
            "state": d["state"],
            "state_reason": d.get("state_reason"),
            "assignees": [a["login"] for a in d.get("assignees") or []],
        }

    @staticmethod
    def _pr(d: dict, branch_key: str) -> dict:
        state = d["state"].lower()
        if d.get("merged_at") or state == "merged":
            state = "merged"
        branch = d["head"]["ref"] if branch_key == "head" else d[branch_key]
        return {"number": d["number"], "url": d.get("html_url") or d.get("url"), "branch": branch, "state": state}

    def user(self) -> str:
        return self._api("user")["login"]

    def issue(self, repo: str, number: int) -> dict:
        return self._issue(self._api(f"repos/{repo}/issues/{number}"), repo)

    def sub_issues(self, repo: str, number: int) -> list[dict]:
        return [self._issue(d) for d in self._api(f"repos/{repo}/issues/{number}/sub_issues?per_page=100", True)]

    def blocked_by(self, repo: str, number: int) -> list[dict]:
        path = f"repos/{repo}/issues/{number}/dependencies/blocked_by?per_page=100"
        return [self._issue(d) for d in self._api(path, True)]

    def prs(self, repo: str, branch: str) -> list[dict]:
        owner = repo.split("/")[0]
        data = self._api(f"repos/{repo}/pulls?state=all&head={owner}:{branch}&per_page=100")
        return sorted((self._pr(d, "head") for d in data), key=lambda p: -p["number"])

    def prs_prefix(self, repo: str, prefix: str) -> list[dict]:
        data = self._run(
            ["pr", "list", "--repo", repo, "--state", "all", "--limit", "100", "--json", "number,url,headRefName,state"]
        )
        prs = (self._pr(d, "headRefName") for d in data if d["headRefName"].startswith(prefix))
        return sorted(prs, key=lambda p: -p["number"])

    def open_issues(self, repo: str, issue_type: str) -> list[dict]:
        path = f"repos/{repo}/issues?state=open&type={urllib.parse.quote(issue_type)}&per_page=100"
        return [self._issue(d, repo) for d in self._api(path, True) if "pull_request" not in d]

    def reviews(self, repo: str, number: int) -> list[dict]:
        data = self._api(f"repos/{repo}/pulls/{number}/reviews?per_page=100", True)
        return [
            {
                "id": d["id"],
                "state": d["state"],
                "body": d.get("body") or "",
                "user": (d.get("user") or {}).get("login"),
            }
            for d in data
        ]


class GhFake:
    """GitHub facts from a JSON file (FAB0_GH_FAKE): {user, issues: {"o/r#n": {...}}, pulls: {"o/r": [...]}}."""

    def __init__(self, path: str):
        self.data = json.loads(Path(path).read_text())

    def user(self) -> str:
        return self.data["user"]

    def _issue(self, ref: str) -> dict:
        repo, number = ref.split("#")
        d = self.data["issues"].get(ref)
        if d is None:
            raise Fail(EXIT_ERROR, f"no issue {ref}")
        return {
            "repo": repo,
            "number": int(number),
            "title": d["title"],
            "body": d.get("body", ""),
            "type": d.get("type"),
            "state": d.get("state", "open"),
            "state_reason": d.get("state_reason"),
            "assignees": d.get("assignees", []),
        }

    def issue(self, repo: str, number: int) -> dict:
        return self._issue(f"{repo}#{number}")

    def sub_issues(self, repo: str, number: int) -> list[dict]:
        return [self._issue(r) for r in self.data["issues"][f"{repo}#{number}"].get("sub_issues", [])]

    def blocked_by(self, repo: str, number: int) -> list[dict]:
        return [self._issue(r) for r in self.data["issues"][f"{repo}#{number}"].get("blocked_by", [])]

    def _prs(self, repo: str) -> list[dict]:
        return sorted(
            (
                {
                    "number": p["number"],
                    "url": f"https://github.com/{repo}/pull/{p['number']}",
                    "branch": p["branch"],
                    "state": p["state"],
                }
                for p in self.data.get("pulls", {}).get(repo, [])
            ),
            key=lambda p: -p["number"],
        )

    def prs(self, repo: str, branch: str) -> list[dict]:
        return [p for p in self._prs(repo) if p["branch"] == branch]

    def prs_prefix(self, repo: str, prefix: str) -> list[dict]:
        return [p for p in self._prs(repo) if p["branch"].startswith(prefix)]

    def open_issues(self, repo: str, issue_type: str) -> list[dict]:
        refs = [r for r, d in self.data["issues"].items() if r.split("#")[0] == repo and d.get("type") == issue_type]
        issues = (self._issue(r) for r in refs)
        return sorted((i for i in issues if i["state"] == "open"), key=lambda i: i["number"])

    def reviews(self, repo: str, number: int) -> list[dict]:
        for p in self.data.get("pulls", {}).get(repo, []):
            if p["number"] == number:
                return p.get("reviews", [])
        return []


def make_gh():
    fake = os.environ.get("FAB0_GH_FAKE")
    return GhFake(fake) if fake else GhCli()


# ---------------------------------------------------------------- the resolver


class Resolver:
    """Computes the next step of one run from the pipeline, the ledgers and GitHub."""

    def __init__(self, wiring: Wiring, gh, run: str, user: str):
        self.w = wiring
        self.gh = gh
        self.run = run
        self.user = user
        p = wiring.project
        self.people = p["people"]
        self.classes = p["models"][HARNESS]
        self.repos = {name: Repo(name, cfg, wiring.root) for name, cfg in p["repos"].items()}
        self.home = self.repos["home"]
        self.issue = gh.issue(self.home.github, int(run))
        self.pipeline = next(
            (
                wiring.pipelines[n]
                for n in p["pipelines"]
                if wiring.pipelines[n]["item"]["issue_type"] == self.issue["type"]
            ),
            None,
        )
        self.steps: list[dict] = []
        self.segment: dict[str, str] = {}  # stage → the stage its branch is named after
        self.producer: dict[str, tuple[str, bool]] = {}  # artifact → (stage, inside a foreach)
        self._ledgers: dict[str, list] = {}
        self._task_issues: dict | None = None
        self._prs: dict[tuple, list] = {}
        self._each_art: str | None = None
        if self.pipeline:
            self._index()

    def _index(self) -> None:
        segment = None
        for raw in self.pipeline["stages"]:
            raw = {"stage": raw} if isinstance(raw, str) else raw
            if "stage" in raw:
                name = raw["stage"]
                stage = self.w.stages[name]
                self.steps.append({"kind": "stage", "name": name})
                if "agent" in stage:
                    segment = segment or name
                    self.segment[name] = segment
                    if stage.get("gate", "none") == "human":
                        segment = None
                else:
                    segment = None
                for out in stage.get("outputs", []):
                    self.producer[out] = (name, False)
            else:
                art, *path = raw["foreach"].split(".")
                self.steps.append(
                    {
                        "kind": "foreach",
                        "art": art,
                        "path": path,
                        "stages": raw["stages"],
                        "gate": raw.get("gate", "none"),
                        "item_type": raw.get("item", {}).get("issue_type", "Task"),
                    }
                )
                for name in raw["stages"]:
                    self.segment[name] = raw["stages"][0]
                    for out in self.w.stages[name].get("outputs", []):
                        self.producer[out] = (name, True)
                segment = None

    # -- facts

    def ledger(self, repo: Repo) -> list:
        if repo.name not in self._ledgers:
            self._ledgers[repo.name] = repo.ledger(self.run)
        return self._ledgers[repo.name]

    def entries(self, repo: Repo, stage: str, task: str | None) -> tuple[list, dict]:
        """A stage's producer attempts, oldest first, and its gate entries by attempt."""
        prods, gates = [], {}
        for entry, src in self.ledger(repo):
            if entry["stage"] != stage or entry.get("task") != task:
                continue
            if "decision" in entry["gate"]:
                gates[entry["attempt"]] = (entry, src)
            else:
                prods.append((entry, src))
        prods.sort(key=lambda x: x[0]["attempt"])
        return prods, gates

    def prs(self, repo: Repo, branch: str) -> list[dict]:
        key = (repo.github, branch)
        if key not in self._prs:
            self._prs[key] = self.gh.prs(repo.github, branch)
        return self._prs[key]

    def newest_pr(self, repo: Repo, branch: str | None) -> dict | None:
        prs = self.prs(repo, branch) if branch else []
        return prs[0] if prs else None

    def review_state(self, repo: Repo, pr: dict | None) -> tuple[str, list]:
        """The reviews that ask for rework on an open PR, and their hash (the `pr-review` input)."""
        if not pr or pr["state"] != "open":
            return EMPTY_REVIEWS, []
        reviews = [
            r
            for r in self.gh.reviews(repo.github, pr["number"])
            if r["state"] in REVIEW_STATES and (r["body"] or r["state"] == "CHANGES_REQUESTED")
        ]
        return sha_json(sorted(r["id"] for r in reviews)), reviews

    def task_issues(self) -> dict:
        """The run's task sub-issues by task id, found by their `[run Tn]` title prefix."""
        if self._task_issues is None:
            pattern = re.compile(rf"^\[{re.escape(self.run)} (T[1-9]\d*)\] ")
            self._task_issues = {}
            for issue in self.gh.sub_issues(self.home.github, int(self.run)):
                match = pattern.match(issue["title"])
                if match and issue.get("state_reason") != "not_planned":
                    self._task_issues[match.group(1)] = issue
        return self._task_issues

    def owner(self, stage: dict, element: dict | None) -> tuple[str | None, list[str]]:
        role = stage.get("owner")
        if role == "repo-owner":
            role = self.repos[element["repo"]].owner
        return role, self.people.get(role, {}).get("github", [])

    def write_repos(self, stage: dict, element: dict | None) -> list[str]:
        write = [element["repo"] if r == "task" else r for r in stage.get("repos", {}).get("write", [])]
        return write or [element["repo"] if element else "home"]

    def ledger_repo(self, stage_name: str, element: dict | None) -> Repo:
        return self.repos[self.write_repos(self.w.stages[stage_name], element)[0]]

    # -- artifacts

    def art_loc(self, name: str, element: dict | None) -> tuple[Repo, str] | None:
        loc = self.w.artifacts[name]["location"]
        if "github" in loc:
            return None
        repo = self.repos[element["repo"] if loc["repo"] == "task" else loc["repo"]]
        path = loc["path"].replace("{run}", self.run)
        if element:
            path = path.replace("{task}", element["id"])
        return repo, path

    def read_art(self, name: str, element: dict | None, src: tuple):
        repo, path = self.art_loc(name, element)
        return repo.read(repo.map_source(src), path, self.w.artifacts[name]["format"])

    def current_src(self, name: str, element: dict | None) -> tuple:
        """Where an artifact's current version is: wherever its producer's latest attempt is, else the base."""
        producer = self.producer.get(name)
        if not producer or (producer[1] and element is None):
            return (BASE, None)
        stage_name, in_each = producer
        el = element if in_each else None
        prods, _ = self.entries(self.ledger_repo(stage_name, el), stage_name, el["id"] if el else None)
        return prods[-1][1] if prods else (BASE, None)

    def input_hashes(self, stage: dict, element: dict | None) -> dict:
        out = {}
        for name in stage.get("inputs", []):
            loc = self.w.artifacts[name]["location"]
            if element is not None and name == self._each_art:
                out[name] = sha_json(element)
            elif loc.get("github") == "issue-body":
                out[name] = sha_text(self.issue["body"])
            elif loc.get("github") == "pr-review":
                continue  # every stage with a PR reads its reviews; see review_state
            else:
                out[name] = sha_content(self.read_art(name, element, self.current_src(name, element)))
        return out

    def output_hashes(self, stage: dict, element: dict | None, src: tuple) -> dict:
        return {o: sha_content(self.read_art(o, element, src)) for o in stage.get("outputs", [])}

    def elements(self, step: dict) -> tuple[list | None, str | None]:
        name = step["art"]
        art = self.w.artifacts[name]
        content = self.read_art(name, None, self.current_src(name, None))
        if content is None:
            return None, f"{name} is missing"
        try:
            data = yaml.safe_load(content)
        except yaml.YAMLError as exc:
            return None, f"{name} doesn't parse: {exc}"
        for key in step["path"]:
            data = data.get(key) if isinstance(data, dict) else None
        if not isinstance(data, list) or not all(isinstance(x, dict) and "id" in x for x in data):
            return None, f"foreach {'.'.join([name, *step['path']])} isn't a list of items with an id"
        if (
            art.get("schema")
            and resolve_schema_ref(art["schema"], self.w.root).resolve() == (SCHEMAS / "tasks.json").resolve()
        ):
            unknown = [t["id"] for t in data if t.get("repo") not in self.repos]
            if unknown:
                return None, f"tasks {', '.join(unknown)} name a repo that isn't in fab0.yaml"
        return data, None

    # -- results

    def result(self, kind: str, **fields) -> dict:
        return {"ok": True, "kind": kind, "run": self.run, **{k: v for k, v in fields.items() if v is not None}}

    def blocked(self, reason: str, **fields) -> dict:
        return self.result("blocked", reason=reason, **fields)

    def wait_owner(self, stage_name: str, role: str, users: list[str]) -> dict:
        return self.result(
            "wait",
            reason="owner",
            stage=stage_name,
            owner=role,
            users=users,
            message=f"{stage_name} is run by {role} ({', '.join(users)}), not {self.user}",
        )

    def wait_pr(
        self,
        reason: str,
        stage_name: str,
        element: dict | None,
        entry: dict,
        repo: Repo,
        pr: dict | None,
        questions: list | None = None,
    ) -> dict:
        role, users = self.owner(self.w.stages[stage_name], element)
        closes = issue_ref(self.task_issues().get(element["id"])) if element else None
        review, draft = self.review_status(reason, stage_name, element, entry, repo)
        return self.result(
            "wait",
            reason=reason,
            stage=stage_name,
            task=element["id"] if element else None,
            repo=repo.name,
            github=repo.github,
            branch=entry.get("branch"),
            pr=pr or None,
            owner=role,
            reviewers=users,
            closes=closes,
            refs=f"{self.home.github}#{self.run}",
            questions=questions,
            review=review,
            draft=draft,
        )

    def review_status(
        self, reason: str, stage_name: str, element: dict | None, entry: dict, repo: Repo
    ) -> tuple[dict | None, bool | None]:
        """What the agent gate has decided on the attempt the branch holds, and whether its PR should be a draft.

        Only for a stage with an agent gate. An attempt that returned questions isn't handed to the gate, so it
        is unreviewed and its PR is a draft; otherwise the gate's decision on the attempt is the statement.
        """
        if not isinstance(self.w.stages[stage_name].get("gate", "none"), dict):
            return None, None
        n = entry["attempt"]
        if reason == "questions":
            text = (
                f"Not reviewed: attempt {n} returned questions, so the review gate hasn't looked at this change. "
                "It reviews the next attempt, after the answers."
            )
            return {"reviewed": False, "attempt": n, "text": text}, True
        got = self.entries(repo, stage_name, element["id"] if element else None)[1].get(n)
        if got is None:
            return None, None
        decision = got[0]["gate"]["decision"]
        text = f"Reviewed: the review gate decided {decision} on attempt {n}."
        return {"reviewed": True, "attempt": n, "decision": decision, "text": text}, False

    def branch_for(self, stage_name: str, element: dict | None, prev: dict | None, repo: Repo) -> tuple[str, str]:
        """The branch an attempt runs on, and whether it starts from that branch or from the base."""
        if prev and prev.get("branch"):
            pr = self.newest_pr(repo, prev["branch"])
            if not (pr and pr["state"] == "merged"):
                exists = repo.ref_exists(prev["branch"]) or repo.ref_exists(f"origin/{prev['branch']}")
                return prev["branch"], "branch" if exists else "base"
        first = self.segment.get(stage_name, stage_name)
        if element:
            name = f"{first}/{self.run}-{element['id']}-{slugify(element['title'])}"
        else:
            name = f"{first}/{self.run}-{slugify(self.issue['title'])}"
        pr = self.newest_pr(repo, name)
        exists = repo.ref_exists(name) or repo.ref_exists(f"origin/{name}")
        return name, "branch" if exists and not (pr and pr["state"] == "merged") else "base"

    def return_schema(self, stage: dict) -> dict:
        schema = copy.deepcopy(core_schema("return.json"))
        extensions = schema.pop("$defs")["extensions"]
        schema.pop("description", None)
        for key, mode in stage.get("return", {}).items():
            schema["properties"][key] = extensions[key]
            if mode == "required":
                schema["required"].append(key)
        return schema

    def stage_result(
        self, stage_name: str, element: dict | None, attempt: int, rework: list[str], prev: dict | None
    ) -> dict:
        stage = self.w.stages[stage_name]
        task = element["id"] if element else None
        role, users = self.owner(stage, element)
        if element is None and self.user not in users:
            return self.wait_owner(stage_name, role, users)
        repo = self.ledger_repo(stage_name, element)
        branch, start = self.branch_for(stage_name, element, prev, repo)
        model = self.classes[stage["model"]]
        inputs = self.input_hashes(stage, element)
        pr = self.newest_pr(repo, branch)
        inputs["pr-review"], reviews = self.review_state(repo, pr)
        write = self.write_repos(stage, element)
        outputs = []
        for name in stage.get("outputs", []):
            out_repo, path = self.art_loc(name, element)
            art = self.w.artifacts[name]
            outputs.append(
                {
                    "name": name,
                    "repo": out_repo.name,
                    "path": path,
                    "abs": str(out_repo.path / path),
                    "format": art["format"],
                    "schema": art.get("schema"),
                }
            )
        schema = self.return_schema(stage)
        gate = stage.get("gate", "none")
        brief = self.render_brief(stage, element, attempt, rework, reviews, outputs, write, branch, schema)
        return self.result(
            "stage",
            stage=stage_name,
            task=task,
            attempt=attempt,
            agent=stage["agent"],
            model=model,
            owner=role,
            repo=repo.name,
            branch=branch,
            start_from=start,
            write=write,
            outputs=outputs,
            pr=pr if pr and pr["state"] == "open" else None,
            return_schema=schema,
            brief=brief,
            _pending={
                "kind": "stage",
                "stage": stage_name,
                "task": task,
                "attempt": attempt,
                "model": model,
                "branch": branch,
                "ledger_repo": repo.name,
                "inputs": inputs,
                "write": write,
                "outputs": outputs,
                "return_schema": schema,
                "gate_type": "agent" if isinstance(gate, dict) else gate,
            },
        )

    def gate_result(self, stage_name: str, element: dict | None, attempt: int, entry: dict) -> dict:
        stage = self.w.stages[stage_name]
        gate = stage["gate"]
        role, users = self.owner(stage, element)
        if element is None and self.user not in users:
            return self.wait_owner(stage_name, role, users)
        repo = self.ledger_repo(stage_name, element)
        model = self.classes[gate["model"]]
        schema = core_schema("review.json")
        brief = self.render_gate_brief(stage, element, attempt, entry, repo, schema)
        return self.result(
            "gate",
            stage=stage_name,
            task=element["id"] if element else None,
            attempt=attempt,
            agent=gate["agent"],
            model=model,
            owner=role,
            repo=repo.name,
            branch=entry.get("branch"),
            return_schema=schema,
            brief=brief,
            _pending={
                "kind": "gate",
                "stage": stage_name,
                "task": element["id"] if element else None,
                "attempt": attempt,
                "model": model,
                "agent": gate["agent"],
                "ledger_repo": repo.name,
                "write": [],
            },
        )

    # -- briefs

    def _input_lines(self, stage: dict, element: dict | None) -> list[str]:
        lines = []
        for name in stage.get("inputs", []):
            art = self.w.artifacts[name]
            loc = art["location"]
            if element is not None and name == self._each_art:
                lines.append(f"- `{name}`: the task above.")
            elif loc.get("github") == "issue-body":
                lines += [
                    f"- `{name}`: the body of {self.home.github}#{self.run}:",
                    "",
                    quote_block(self.issue["body"]),
                    "",
                ]
            elif loc.get("github"):
                continue
            else:
                repo, path = self.art_loc(name, element)
                src = repo.map_source(self.current_src(name, element))
                text = inline_text(repo.read(src, path, art["format"]))
                if text is not None:
                    where = "the working tree" if src[0] == WORKTREE else repo.out("rev-parse", repo.ref_for(src))
                    lines += [
                        f"- `{name}` ({art['format']}): `{path}` in {repo.name}, at {where}:",
                        "",
                        "~~~~" + FENCE_LANG.get(art["format"], ""),
                        text.rstrip("\n"),
                        "~~~~",
                        "",
                    ]
                elif src[0] == WORKTREE:
                    lines.append(f"- `{name}` ({art['format']}): `{repo.path / path}`")
                else:
                    commit = repo.out("rev-parse", repo.ref_for(src))
                    how = "git ls-tree -r" if art["format"] == "dir" else "git show"
                    target = f"{commit} -- {path}" if art["format"] == "dir" else f"{commit}:{path}"
                    lines.append(
                        f"- `{name}` ({art['format']}): `{path}` in {repo.name}, at commit {commit}: "
                        f"read it with `git -C {repo.path} {how} {target}`"
                    )
        return lines or ["(none)"]

    def _header(self, title: str, stage: dict, element: dict | None) -> list[str]:
        issue = self.issue
        lines = [
            f"# fab0 brief: {title}",
            "",
            f'Run {self.run}: {issue["type"]} {self.home.github}#{self.run}, "{issue["title"]}".',
            "",
            f"Handed out by fab0 {read_version()}.",
            "",
        ]
        if element:
            lines += [
                "## Task",
                "",
                "```yaml",
                yaml.safe_dump(element, sort_keys=False, allow_unicode=True).rstrip(),
                "```",
                "",
            ]
        return lines

    def _other_tasks_lines(self, element: dict | None) -> list[str]:
        """The `## Other tasks of this run` section: the other items of the foreach list, in list order."""
        if element is None:
            return []
        step = next((s for s in self.steps if s["kind"] == "foreach" and s["art"] == self._each_art), None)
        items = self.elements(step)[0] if step else None
        if items is None:
            return []
        lines = ["## Other tasks of this run", ""]
        others = [i for i in items if i["id"] != element["id"]]
        if not others:
            return lines + ["This run has no other tasks.", ""]
        for item in others:
            parts = [f"`{item['id']}`"]
            if item.get("title"):
                parts.append(f"{item['title']}")
            line = "- " + ": ".join(parts)
            details = []
            if item.get("repo"):
                details.append(f"repo {item['repo']}")
            traces = item.get("traces_to") or []
            details.append(("delivers " + ", ".join(str(t) for t in traces)) if traces else "delivers no scenarios")
            lines.append(f"{line} ({'; '.join(details)})")
        return lines + [""]

    def render_brief(
        self,
        stage: dict,
        element: dict | None,
        attempt: int,
        rework: list[str],
        reviews: list,
        outputs: list,
        write: list[str],
        branch: str,
        schema: dict,
    ) -> str:
        task = f", task {element['id']}" if element else ""
        lines = self._header(f"{stage['stage']}{task}, attempt {attempt}", stage, element)
        lines += self._other_tasks_lines(element)
        lines += ["Do only the work below. Don't commit, push, or use GitHub; fab0 does that when you return.", ""]
        lines += ["## Inputs", "", *self._input_lines(stage, element), ""]
        lines += ["## Outputs", ""]
        for out in outputs:
            checks = []
            art = self.w.artifacts[out["name"]]
            if out["schema"]:
                path = resolve_schema_ref(out["schema"], self.w.root)
                checks.append(f"it must validate against the JSON Schema in `{path}`")
            for check in art.get("verify", []):
                if "sections" in check:
                    checks.append("it must have the sections " + ", ".join(f"`{s}`" for s in check["sections"]))
                elif "lint" in check:
                    checks.append(f"it must pass `{check['lint']}`")
                elif "script" in check:
                    checks.append(f"it must pass `{check['script']}`")
            lines.append(
                f"- `{out['name']}` ({out['format']}): write `{out['abs']}`"
                + ("; " + "; ".join(checks) if checks else ".")
            )
        if not outputs:
            lines.append(f"- No declared artifacts: make the changes the task needs in {', '.join(write)}.")
        lines.append("")
        read = stage.get("repos", {}).get("read", [])
        read = list(self.repos) if "all" in read else [element["repo"] if r == "task" else r for r in read]
        lines += [
            "## Repositories",
            "",
            "You may change files only in: "
            + ", ".join(f"{n} (`{self.repos[n].path}`)" for n in write)
            + f", on branch `{branch}`. A change anywhere else fails the stage.",
        ]
        if read:
            lines.append("You may read: " + ", ".join(f"{n} (`{self.repos[n].path}`)" for n in read) + ".")
        lines.append("")
        if stage.get("skills"):
            lines += ["## Skills", "", "Use: " + ", ".join(f"`{s}`" for s in stage["skills"]) + ".", ""]
        if rework or reviews:
            lines += ["## Rework", "", f"This is attempt {attempt}. What the earlier attempt left open:", ""]
            lines += [f"- {r}" if "\n" not in r else r for r in rework]
            if reviews:
                lines += ["", "Reviews on the pull request:", ""]
                for r in reviews:
                    lines += [
                        f"- {r.get('user') or 'a reviewer'} ({r['state'].lower().replace('_', ' ')}):",
                        "",
                        quote_block(r["body"]),
                        "",
                    ]
            lines.append("")
        lines += [
            "## Return",
            "",
            "When you are done, reply with exactly one JSON object and nothing else, valid against this schema:",
            "",
            "```json",
            json.dumps(schema, indent=2),
            "```",
        ]
        if "questions" in stage.get("return", {}):
            role, _ = self.owner(stage, element)
            lines += [
                "",
                f"If you can't go on without a decision from {role}, write what you can and return "
                "`questions` instead of guessing.",
            ]
        return "\n".join(lines) + "\n"

    def render_gate_brief(
        self, stage: dict, element: dict | None, attempt: int, entry: dict, repo: Repo, schema: dict
    ) -> str:
        task = f", task {element['id']}" if element else ""
        lines = self._header(f"gate of {stage['stage']}{task}, attempt {attempt}", stage, element)
        lines += [
            f"You are the gate of stage `{stage['stage']}`. Review what attempt {attempt} produced against "
            "its inputs. Change nothing.",
            "",
        ]
        lines += ["## Inputs of the stage", "", *self._input_lines(stage, element), ""]
        lines += ["## What it produced", ""]
        if entry.get("summary"):
            lines += ["Its summary:", "", quote_block(entry["summary"]), ""]
        for name in stage.get("outputs", []):
            out_repo, path = self.art_loc(name, element)
            lines.append(f"- `{name}`: `{out_repo.path / path}`")
        if entry.get("branch"):
            ledger = f"work/{self.run}/ledger"
            lines += [
                f"- The changes: `git -C {repo.path} diff {repo.base_ref}...{entry['branch']} -- . "
                f"':(exclude){ledger}'`",
                f"- Files under `{ledger}/` are fab0's own records of the run, not part of the result. "
                "Leave them out of every check.",
            ]
        lines += [
            "",
            "## Decide",
            "",
            "- `approve` when the result does what the inputs ask.",
            "- `reject` with findings when the producer can fix it; it re-runs with your findings.",
            "- `escalate` when a person has to decide.",
            "List each scenario or requirement the result doesn't meet in `unmet`.",
            "",
        ]
        lines += [
            "## Return",
            "",
            "Reply with exactly one JSON object and nothing else, valid against this schema:",
            "",
            "```json",
            json.dumps(schema, indent=2),
            "```",
        ]
        return "\n".join(lines) + "\n"

    @staticmethod
    def findings_text(gate_entry: dict) -> str:
        review = gate_entry.get("review", {})
        lines = [f"The gate ({gate_entry['gate'].get('agent')}) rejected attempt {gate_entry['attempt']}:"]
        lines += [f"  - {r}" for r in review.get("reasons", [])]
        for f in review.get("findings", []):
            where = f" ({f['location']})" if f.get("location") else ""
            lines.append(f"  - [{f.get('check', 'finding')}] {f['message']}{where}")
        if review.get("unmet"):
            lines.append("  - Unmet: " + ", ".join(review["unmet"]))
        return "- " + "\n".join(lines)

    # -- evaluation

    def next(self, task: str | None = None) -> dict:
        if self.pipeline is None:
            return self.blocked(f"no pipeline in fab0.yaml runs issue type {self.issue['type']!r}")
        last = self.steps[-1]
        if last["kind"] == "stage" and "action" in self.w.stages[last["name"]]:
            if self.eval_step(last, None) is None:
                return self.result("done")
        for step in self.steps:
            res = self.eval_step(step, task)
            if res is not None:
                return res
        return self.result("done")

    def eval_step(self, step: dict, task: str | None) -> dict | None:
        """None when the step is satisfied; otherwise what to do or why not."""
        if step["kind"] == "foreach":
            return self.eval_foreach(step, task)
        stage = self.w.stages[step["name"]]
        if stage.get("action") == "plan":
            return self.check_plan(stage)
        if stage.get("action") == "deliver":
            return self.check_deliver(stage)
        return self.eval_agent(step["name"], None)

    def eval_agent(self, stage_name: str, element: dict | None) -> dict | None:
        stage = self.w.stages[stage_name]
        task = element["id"] if element else None
        repo = self.ledger_repo(stage_name, element)
        prods, gates = self.entries(repo, stage_name, task)
        inputs = self.input_hashes(stage, element)
        missing = sorted(k for k, v in inputs.items() if v is None)
        if missing:
            return self.blocked(
                f"{stage_name}{' ' + task if task else ''} is missing its input {', '.join(missing)}",
                stage=stage_name,
                task=task,
            )
        if not prods:
            return self.stage_result(stage_name, element, 1, [], None)
        entry, src = prods[-1]
        n = entry["attempt"]
        on_base = src[0] == BASE

        rework = []
        recorded = entry.get("inputs", {})
        changed = sorted(k for k in inputs if recorded.get(k) != inputs[k])
        if changed:
            rework.append(f"The inputs changed since attempt {n}: {', '.join(changed)}. Bring the outputs up to date.")
        outputs = self.output_hashes(stage, element, src)
        edited = sorted(k for k, v in outputs.items() if v != entry.get("outputs", {}).get(k))
        if edited:
            rework.append(
                f"Since attempt {n}, someone changed or removed: {', '.join(edited)}. Start from the "
                "files as they are now, and take the edits as answers or corrections."
            )
        failed = {k: v for k, v in entry.get("verify", {}).items() if v != "pass"}
        if failed:
            rework.append(
                f"- Verification failed in attempt {n}:\n"
                + "\n".join(f"  - {k}: {msg}" for k, msgs in failed.items() for msg in msgs)
            )
        if rework:
            return self.stage_result(stage_name, element, n + 1, rework, entry)
        if on_base:
            return None

        pr = self.newest_pr(repo, entry.get("branch"))
        review_hash, _ = self.review_state(repo, pr)
        if pr and pr["state"] == "open" and review_hash != recorded.get("pr-review", EMPTY_REVIEWS):
            return self.stage_result(
                stage_name, element, n + 1, ["There are new reviews on the pull request; address them."], entry
            )
        if entry.get("questions"):
            return self.wait_pr("questions", stage_name, element, entry, repo, pr, questions=entry["questions"])

        gate = stage.get("gate", "none")
        escalated = False
        if isinstance(gate, dict):
            got = gates.get(n)
            if got is None:
                return self.gate_result(stage_name, element, n, entry)
            decision = got[0]["gate"]["decision"]
            if decision == "approve":
                return None
            if decision == "reject":
                rejects = sum(1 for g, _ in gates.values() if g["gate"]["decision"] == "reject")
                if rejects <= MAX_REWORK:
                    return self.stage_result(stage_name, element, n + 1, [self.findings_text(got[0])], entry)
            escalated = True
        elif gate == "none":
            return None
        return self.human_gate("escalated" if escalated else "human-gate", stage_name, element, entry, repo, pr)

    def human_gate(
        self, reason: str, stage_name: str, element: dict | None, entry: dict, repo: Repo, pr: dict | None
    ) -> dict:
        # The entry isn't on the base, so a merged PR on this branch is an earlier attempt's: this one needs a new
        # PR. (If it is this attempt's, the base is behind: the orchestrator fetches before every `next`.)
        return self.wait_pr(reason, stage_name, element, entry, repo, pr if pr and pr["state"] != "merged" else None)

    def element_done(self, step: dict, element: dict) -> bool:
        last = step["stages"][-1]
        prods, _ = self.entries(self.ledger_repo(last, element), last, element["id"])
        if not prods:
            return False
        if step["gate"] == "human":
            return prods[-1][1][0] == BASE
        return all(self.eval_agent(name, element) is None for name in step["stages"])

    def element_status(self, step: dict, element: dict, done: dict, issues: dict) -> dict:
        tid = element["id"]
        if done[tid]:
            return self.result("done", task=tid)
        issue = issues.get(tid)
        if issue is None:
            return self.blocked(f"{tid} has no task issue yet; plan creates it", task=tid)
        waiting = [d for d in element.get("depends_on", []) if not done.get(d, False)]
        if waiting:
            return self.blocked(f"{tid} is blocked by {', '.join(waiting)}", task=tid)
        own = {(i["repo"], i["number"]) for i in issues.values()}
        external = [
            issue_ref(b)
            for b in self.gh.blocked_by(issue["repo"], issue["number"])
            if b["state"] == "open" and (b["repo"], b["number"]) not in own
        ]
        if external:
            return self.blocked(f"{tid} is blocked by {', '.join(external)}", task=tid)
        if self.user not in issue["assignees"]:
            return self.result(
                "wait",
                reason="assigned",
                task=tid,
                issue=issue_ref(issue),
                assignees=issue["assignees"],
                message=f"{tid} is assigned to {', '.join(issue['assignees']) or 'nobody'}; pass --take to claim it",
            )
        for name in step["stages"]:
            res = self.eval_agent(name, element)
            if res is not None:
                return res
        if step["gate"] == "human":
            last = step["stages"][-1]
            repo = self.ledger_repo(last, element)
            entry = self.entries(repo, last, tid)[0][-1][0]
            return self.human_gate("human-gate", last, element, entry, repo, self.newest_pr(repo, entry.get("branch")))
        return self.result("done", task=tid)

    def eval_foreach(self, step: dict, task: str | None) -> dict | None:
        elements, error = self.elements(step)
        if elements is None:
            return self.blocked(error)
        self._each_art = step["art"]
        if task is not None and task not in [e["id"] for e in elements]:
            return self.blocked(f"{task} is not a task of run {self.run}", task=task)
        issues = self.task_issues()
        done = {e["id"]: self.element_done(step, e) for e in elements}
        if all(done.values()):
            return None
        if task is not None:
            return self.element_status(step, next(e for e in elements if e["id"] == task), done, issues)
        runnable, others = [], []
        for element in elements:
            res = self.element_status(step, element, done, issues)
            item = {
                "task": element["id"],
                "title": element["title"],
                "repo": element["repo"],
                "issue": issue_ref(issues.get(element["id"])),
            }
            if res["kind"] in ("stage", "gate"):
                runnable.append({**item, "next": res["kind"], "stage": res["stage"]})
            else:
                others.append(
                    {
                        **item,
                        "state": res.get("reason", res["kind"]) if res["kind"] == "wait" else res["kind"],
                        "detail": res.get("message") or res.get("reason") if res["kind"] != "done" else None,
                    }
                )
        if runnable:
            ids = {r["task"] for r in runnable}
            return self.result(
                "tasks", runnable=runnable, lanes=lanes([e for e in elements if e["id"] in ids]), others=others
            )
        return self.result("wait", reason="tasks", tasks=others)

    # -- actions

    def check_plan(self, stage: dict) -> dict | None:
        """The plan action: the run's Task sub-issues must match the task list."""
        name = stage["inputs"][0]
        step = next(s for s in self.steps if s["kind"] == "foreach" and s["art"] == name)
        elements, error = self.elements(step)
        if elements is None:
            return self.blocked(error, stage=stage["stage"])
        by_id = {e["id"]: e for e in elements}
        issues = self.task_issues()
        parent = {"repo": self.home.github, "number": int(self.run)}

        def ref(tid: str) -> dict:
            issue = issues.get(tid)
            if issue:
                return {"task": tid, "repo": issue["repo"], "number": issue["number"]}
            return {"task": tid, "repo": self.repos[by_id[tid]["repo"]].github, "number": None}

        ops = []
        for element in elements:
            repo = self.repos[element["repo"]]
            title = f"[{self.run} {element['id']}] {element['title']}"
            issue = issues.get(element["id"])
            if issue is None:
                ops.append(
                    {
                        "op": "create-issue",
                        "issue": ref(element["id"]),
                        "type": step["item_type"],
                        "title": title,
                        "body": self.task_body(element, name),
                        "assignees": self.people[repo.owner]["github"],
                    }
                )
                ops.append({"op": "add-sub-issue", "parent": parent, "child": ref(element["id"])})
                continue
            if issue["repo"] != repo.github:
                return self.blocked(
                    f"{element['id']} moved from {issue['repo']} to {repo.github}; close "
                    f"{issue_ref(issue)} as not planned and run again",
                    stage=stage["stage"],
                )
            if issue["title"] != title:
                ops.append({"op": "edit-title", "issue": ref(element["id"]), "title": title})
        for tid, issue in issues.items():
            if tid not in by_id and issue["state"] == "open":
                ops.append({"op": "close-issue", "issue": ref(tid), "reason": "not_planned"})
        numbers = {(i["repo"], i["number"]): tid for tid, i in issues.items()}
        for element in elements:
            want = set(element.get("depends_on", []))
            have = set()
            issue = issues.get(element["id"])
            if issue:
                for b in self.gh.blocked_by(issue["repo"], issue["number"]):
                    if (b["repo"], b["number"]) in numbers:
                        have.add(numbers[(b["repo"], b["number"])])
            for dep in sorted(want - have):
                ops.append({"op": "add-blocked-by", "issue": ref(element["id"]), "blocked_by": ref(dep)})
            for dep in sorted(have - want):
                ops.append({"op": "remove-blocked-by", "issue": ref(element["id"]), "blocked_by": ref(dep)})
        if not ops:
            return None
        return self.result("action", stage=stage["stage"], action="plan", ops=ops)

    def task_body(self, element: dict, art_name: str) -> str:
        repo, path = self.art_loc(art_name, None)
        lines = [
            f"Task {element['id']} of {self.home.github}#{self.run}.",
            "",
            "Files: " + ", ".join(f"`{f}`" for f in element["files"]),
        ]
        if element.get("depends_on"):
            lines.append("Depends on: " + ", ".join(element["depends_on"]))
        if element.get("traces_to"):
            lines.append("Traces to: " + ", ".join(element["traces_to"]))
        lines += [
            "",
            f"From `{path}` in {repo.github}. fab0 finds this issue by the bracketed prefix of its title, so keep it.",
        ]
        return "\n".join(lines)

    def check_deliver(self, stage: dict) -> dict | None:
        """The deliver action: one PR in the home repo that closes the run's issue."""
        home = self.home
        prefix = f"{stage['stage']}/{self.run}-"
        prs = self.gh.prs_prefix(home.github, prefix)
        if any(p["state"] == "merged" for p in prs):
            return None
        users = self.people[home.owner]["github"]
        open_prs = [p for p in prs if p["state"] == "open"]
        if open_prs:
            return self.result(
                "wait",
                reason="human-gate",
                stage=stage["stage"],
                repo="home",
                github=home.github,
                branch=open_prs[0]["branch"],
                pr=open_prs[0],
                owner=home.owner,
                reviewers=users,
                closes=f"{home.github}#{self.run}",
            )
        doc = stage["inputs"][0]
        doc_repo, doc_path = self.art_loc(doc, None)
        branch = f"{prefix}{slugify(self.issue['title'])}"
        ops = [{"op": "branch", "repo": home.github, "branch": branch, "from": home.base}]
        if doc_repo is home:
            ops.append({"op": "append", "repo": home.github, "path": doc_path, "text": self.delivered_text()})
        notes = []
        for name, art in self.w.artifacts.items():
            loc = art["location"]
            if art.get("keep") != "run" or "repo" not in loc or loc["repo"] == "task":
                continue
            repo, path = self.art_loc(name, None)
            if repo is not home:
                notes.append(f"{name} ({path} in {repo.name}) is kept: deliver only changes the home repo for now")
            elif repo.read((BASE, None), path, art["format"]) is not None:
                ops.append({"op": "remove", "repo": home.github, "path": path})
        title = self.issue["title"]
        ops.append(
            {
                "op": "open-pr",
                "repo": home.github,
                "branch": branch,
                "title": f"Deliver #{self.run}: {title}",
                "body": f"Closes #{self.run}\n\nDelivers {title}.",
                "assignees": users,
                "reviewers": users,
            }
        )
        return self.result("action", stage=stage["stage"], action="deliver", ops=ops, notes=notes or None)

    def delivered_text(self) -> str:
        lines = [
            "",
            "## Delivered",
            "",
            "| Task | Repository | Pull request | Review | Unmet |",
            "|---|---|---|---|---|",
        ]
        for step in self.steps:
            if step["kind"] != "foreach":
                continue
            elements, _ = self.elements(step)
            self._each_art = step["art"]
            for element in elements or []:
                pr_text, review, unmet = "", "", ""
                for name in step["stages"]:
                    repo = self.ledger_repo(name, element)
                    prods, gates = self.entries(repo, name, element["id"])
                    if prods:
                        pr = self.newest_pr(repo, prods[-1][0].get("branch"))
                        pr_text = f"{repo.github}#{pr['number']}" if pr else pr_text
                    if gates:
                        last = gates[max(gates)][0]
                        review = f"{last['gate']['decision']} (attempt {last['attempt']})"
                        unmet = ", ".join(last.get("review", {}).get("unmet", []))
                lines.append(
                    f"| {element['id']} {element['title']} | {element['repo']} | {pr_text or '—'} | "
                    f"{review or '—'} | {unmet or '—'} |"
                )
        return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- commands


def find_project(arg: str | None) -> Path:
    if arg:
        root = Path(arg).resolve()
        if not (root / ".fab0" / "fab0.yaml").is_file():
            raise Fail(EXIT_USAGE, f"no .fab0/fab0.yaml in {root}")
        return root
    here = Path.cwd().resolve()
    for folder in (here, *here.parents):
        if (folder / ".fab0" / "fab0.yaml").is_file():
            return folder
    raise Fail(EXIT_USAGE, f"no .fab0/fab0.yaml in {here} or above it; pass --project")


def load_wiring(args) -> Wiring:
    wiring = Wiring(find_project(args.project), getattr(args, "profile", None))
    if wiring.errors:
        raise Fail(EXIT_INVALID, "invalid wiring", errors=wiring.errors)
    return wiring


def check_run(run: str) -> None:
    if not re.fullmatch(r"[1-9]\d*", run):
        raise Fail(EXIT_USAGE, f"run id '{run}': only top-level runs (issue numbers) are supported for now")


def pending_path(home: Repo, run: str, stage: str, task: str | None, gate: bool) -> Path:
    name = f"{run}-{stage}" + (f"-{task}" if task else "") + ("-gate" if gate else "") + ".json"
    return home.git_dir() / "fab0" / "pending" / name


def cmd_validate(args) -> dict:
    wiring = load_wiring(args)
    return {
        "ok": True,
        "project": str(wiring.root),
        "pipelines": wiring.project["pipelines"],
        "stages": sorted(wiring.stages),
        "artifacts": sorted(wiring.artifacts),
        "workspace": workspace(wiring),
    }


def workspace(wiring: Wiring) -> dict:
    repos = (Repo(name, cfg, wiring.root) for name, cfg in wiring.project["repos"].items())
    return {r.name: {"path": str(r.path), "github": r.github, "exists": r.exists(), "base": r.base} for r in repos}


def cmd_next(args) -> dict:
    wiring = load_wiring(args)
    check_run(args.run)
    gh = make_gh()
    user = args.as_user or gh.user()
    resolver = Resolver(wiring, gh, args.run, user)
    result = resolver.next(args.task)
    pending = result.pop("_pending", None)
    if pending:
        pending.update(
            {
                "run": args.run,
                "actor": user,
                "scope": {
                    name: repo.scope_state() for name, repo in resolver.repos.items() if name not in pending["write"]
                },
            }
        )
        path = pending_path(resolver.home, args.run, pending["stage"], pending["task"], pending["kind"] == "gate")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(pending, indent=2))
    if result.get("kind") in ("stage", "gate"):
        result["fab0_version"] = read_version()
    result["workspace"] = workspace(wiring)
    return result


def describe_wait(res: dict) -> str:
    reason = res["reason"]
    if reason == "human-gate":
        pr = res.get("pr")
        where = pr["url"] if pr else "its PR (not opened yet)"
        return f"{res.get('stage')}: {where} awaits review by {', '.join(res.get('reviewers', []))}"
    if reason == "questions":
        return f"{res.get('stage')}: questions for {res.get('owner')}"
    if reason == "escalated":
        return f"{res.get('stage')}: the gate escalated to {res.get('owner')}"
    return res.get("message") or reason


def cmd_inbox(args) -> dict:
    """What each open run needs, from the user's point of view: the same answers `next` gives, without hand-outs."""
    wiring = load_wiring(args)
    gh = make_gh()
    user = args.as_user or gh.user()
    home = wiring.project["repos"]["home"]["github"]
    out = {"ready": [], "actions": [], "waiting": [], "blocked": [], "done": []}
    for name in wiring.project["pipelines"]:
        issue_type = wiring.pipelines[name]["item"]["issue_type"]
        for issue in gh.open_issues(home, issue_type):
            run = str(issue["number"])
            res = Resolver(wiring, gh, run, user).next(None)
            item = {"run": run, "type": issue_type, "title": issue["title"]}
            kind = res["kind"]
            if kind in ("stage", "gate"):
                out["ready"].append({**item, "command": f"/fab0:run {run}", "stage": res["stage"]})
            elif kind == "action":
                out["actions"].append({**item, "command": f"/fab0:run {run}", "action": res["action"]})
            elif kind == "tasks" or (kind == "wait" and res["reason"] == "tasks"):
                for task in res.get("runnable", []):
                    command = f"/fab0:run {run} --task {task['task']}"
                    out["ready"].append(
                        {
                            **item,
                            "command": command,
                            "stage": task["stage"],
                            "task": task["task"],
                            "task_title": task["title"],
                        }
                    )
                for task in res.get("others", res.get("tasks", [])):
                    if task["state"] != "done":
                        out["waiting"].append(
                            {
                                **item,
                                "task": task["task"],
                                "task_title": task["title"],
                                "reason": task.get("detail") or task["state"],
                            }
                        )
            elif (
                kind == "wait"
                and res["reason"] == "human-gate"
                and not res.get("pr")
                and user in res.get("reviewers", [])
            ):
                # Recorded but never pushed: /fab0:run opens the PR.
                out["ready"].append(
                    {
                        **item,
                        "command": f"/fab0:run {run}",
                        "stage": res.get("stage"),
                        "task": res.get("task"),
                        "note": "open its PR",
                    }
                )
            elif kind == "wait":
                out["waiting"].append(
                    {**item, "stage": res.get("stage"), "task": res.get("task"), "reason": describe_wait(res)}
                )
            elif kind == "blocked":
                out["blocked"].append({**item, "reason": res["reason"]})
            else:
                out["done"].append(item)
    return {"ok": True, "user": user, **out}


def cmd_record(args) -> dict:
    wiring = load_wiring(args)
    check_run(args.run)
    repos = {name: Repo(name, cfg, wiring.root) for name, cfg in wiring.project["repos"].items()}
    path = pending_path(repos["home"], args.run, args.stage, args.task, args.gate)
    if not path.is_file():
        raise Fail(
            EXIT_REFUSED,
            f"nothing handed out for {args.stage}{' ' + args.task if args.task else ''}"
            f"{' (gate)' if args.gate else ''} in run {args.run}; run `fab0-resolve next` first",
        )
    pending = json.loads(path.read_text())

    violations = {}
    for name, before in pending["scope"].items():
        changes = scope_diff(before, repos[name].scope_state())
        if changes:
            violations[name] = changes
    if violations:
        raise Fail(
            EXIT_REFUSED,
            "the stage changed repositories it may not write; undo those changes and record again",
            violations=violations,
        )

    try:
        returned = json.loads(Path(args.return_file).read_text())
        return_errors = []
    except (OSError, json.JSONDecodeError) as exc:
        returned, return_errors = None, [f"the return isn't readable JSON: {exc}"]

    base = {
        "stage": args.stage,
        "task": args.task,
        "attempt": pending["attempt"],
        "actor": pending["actor"],
        "model": pending["model"],
    }
    if args.gate:
        return_errors = return_errors or schema_errors(returned, core_schema("review.json"))
        if return_errors:
            raise Fail(
                EXIT_REFUSED, "the gate's return isn't a valid review; call the gate again", errors=return_errors
            )
        entry = {
            **base,
            "gate": {"type": "agent", "agent": pending["agent"], "decision": returned["decision"]},
            "review": returned,
        }
    else:
        if returned is not None:
            return_errors = schema_errors(returned, pending["return_schema"])
        outputs, verify = {}, {}
        for out in pending["outputs"]:
            repo = repos[out["repo"]]
            content = repo.read((WORKTREE, None), out["path"], out["format"])
            if content is not None:
                outputs[out["name"]] = sha_content(content)
            errors = verify_artifact(wiring, wiring.artifacts[out["name"]], repo, out["path"], content)
            verify[out["name"]] = errors or "pass"
        if return_errors:
            verify["return"] = return_errors
        entry = {
            **base,
            "branch": pending["branch"],
            "inputs": pending["inputs"],
            "outputs": outputs,
            "verify": verify,
            "gate": {"type": pending["gate_type"]},
        }
        if not return_errors:
            entry["summary"] = returned["summary"]
            if returned.get("questions"):
                entry["questions"] = returned["questions"]
    entry = {k: v for k, v in entry.items() if v is not None}

    ledger_repo = repos[pending["ledger_repo"]]
    rel = f"work/{args.run}/ledger/{entry_name(entry)}"
    target = ledger_repo.path / rel
    if target.exists():
        raise Fail(EXIT_REFUSED, f"{rel} already exists in {ledger_repo.name}; the ledger is append-only")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(yaml.safe_dump(entry, sort_keys=False, allow_unicode=True, width=1000))
    path.unlink()
    verify = entry.get("verify", {})
    return {
        "ok": True,
        "repo": ledger_repo.name,
        "entry": rel,
        "verified": all(v == "pass" for v in verify.values()),
        "verify": verify or None,
        "decision": entry["gate"].get("decision"),
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="fab0-resolve", description="The fab0 resolver.")
    parser.add_argument("--version", action="store_true", help="print the fab0 release of this resolver")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("validate", help="check the project's .fab0/ wiring")
    p.add_argument("--project", help="the home repo (default: found from the current directory)")
    p.add_argument("--profile", help="a profile from fab0.yaml to apply")
    p.set_defaults(handler=cmd_validate)

    p = sub.add_parser("next", help="compute what a run needs next")
    p.add_argument("run", help="the run id: the issue number of the run's item")
    p.add_argument("--task", help="evaluate only this task, for example T2")
    p.add_argument("--profile", help="a profile from fab0.yaml to apply")
    p.add_argument("--as", dest="as_user", help="the GitHub user running it (default: the gh login)")
    p.add_argument("--project", help="the home repo (default: found from the current directory)")
    p.set_defaults(handler=cmd_next)

    p = sub.add_parser("record", help="record the result of a stage or gate that next handed out")
    p.add_argument("run")
    p.add_argument("stage")
    p.add_argument("--task")
    p.add_argument("--gate", action="store_true", help="record the stage's agent gate")
    p.add_argument("--return", dest="return_file", required=True, help="a file with the agent's JSON return")
    p.add_argument("--project", help="the home repo (default: found from the current directory)")
    p.set_defaults(handler=cmd_record)

    p = sub.add_parser("inbox", help="what every open run needs, for one user; read-only")
    p.add_argument("--as", dest="as_user", help="the GitHub user (default: the gh login)")
    p.add_argument("--profile", help="a profile from fab0.yaml to apply")
    p.add_argument("--project", help="the home repo (default: found from the current directory)")
    p.set_defaults(handler=cmd_inbox)

    args = parser.parse_args(argv)
    if args.version:
        args.handler = cmd_version
    elif not args.command:
        parser.error("a command is required")
    try:
        result, code = args.handler(args), EXIT_OK
    except Fail as fail:
        result, code = {"ok": False, **fail.payload}, fail.code
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return code


if __name__ == "__main__":
    sys.exit(main())
