{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fab0 stage (.fab0/stages/<name>.yaml)",
  "type": "object",
  "required": ["stage"],
  "additionalProperties": false,
  "oneOf": [{"required": ["agent"]}, {"required": ["action"]}],
  "properties": {
    "stage": {"$ref": "#/$defs/name"},
    "agent": {"$ref": "#/$defs/agent"},
    "action": {"enum": ["plan", "deliver"]},
    "model": {"$ref": "#/$defs/name"},
    "inputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "repos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "read": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"}},
    "return": {"type": "object", "additionalProperties": {"enum": ["optional", "required"]}},
    "owner": {"$ref": "#/$defs/name"},
    "gate": {
      "oneOf": [
        {"enum": ["none", "human"]},
        {
          "type": "object",
          "required": ["agent", "model"],
          "additionalProperties": false,
          "properties": {
            "agent": {"$ref": "#/$defs/agent"},
            "model": {"$ref": "#/$defs/name"}
          }
        }
      ]
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "agent": {"type": "string", "pattern": "^([a-z0-9][a-z0-9_-]*:)?[a-z0-9][a-z0-9_-]*$"}
  }
}
