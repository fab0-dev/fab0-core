{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fab0 review: the return of an agent gate",
  "type": "object",
  "required": ["decision", "reasons"],
  "additionalProperties": false,
  "properties": {
    "decision": {"enum": ["approve", "escalate", "reject"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "additionalProperties": false,
        "properties": {
          "check": {"type": "string"},
          "message": {"type": "string", "minLength": 1},
          "location": {"type": "string"}
        }
      }
    },
    "unmet": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
