{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fab0 artifact type (.fab0/artifacts/<name>.yaml)",
  "type": "object",
  "required": ["artifact", "format", "location"],
  "additionalProperties": false,
  "properties": {
    "artifact": {"$ref": "#/$defs/name"},
    "format": {"enum": ["markdown", "yaml", "json", "gherkin", "openapi", "file", "dir"]},
    "location": {
      "oneOf": [
        {
          "type": "object",
          "required": ["repo", "path"],
          "additionalProperties": false,
          "properties": {
            "repo": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["github"],
          "additionalProperties": false,
          "properties": {"github": {"enum": ["issue-body", "pr", "pr-review"]}}
        }
      ]
    },
    "schema": {"type": "string", "minLength": 1},
    "verify": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["sections"],
            "additionalProperties": false,
            "properties": {"sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
          },
          {
            "type": "object",
            "required": ["lint"],
            "additionalProperties": false,
            "properties": {"lint": {"type": "string", "pattern": "\\{path\\}"}}
          },
          {
            "type": "object",
            "required": ["script"],
            "additionalProperties": false,
            "properties": {"script": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}}
          }
        ]
      }
    },
    "keep": {"enum": ["run", "durable"]}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
  }
}
