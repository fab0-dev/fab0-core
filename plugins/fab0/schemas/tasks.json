{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fab0 tasks (tasks.yaml): the tasks of one run",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "repo", "files"],
    "additionalProperties": false,
    "properties": {
      "id": {"$ref": "#/$defs/id"},
      "title": {"type": "string", "minLength": 1},
      "repo": {"type": "string", "minLength": 1},
      "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "traces_to": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^T[1-9][0-9]*$"}
  }
}
