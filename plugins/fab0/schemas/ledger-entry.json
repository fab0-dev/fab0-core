{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fab0 ledger entry (work/{run}/ledger/<stage>[-<task>]-<attempt>[-gate].yaml)",
  "type": "object",
  "required": ["stage", "attempt", "actor", "model", "gate"],
  "additionalProperties": false,
  "properties": {
    "stage": {"type": "string"},
    "task": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "actor": {"type": "string"},
    "model": {"type": "string"},
    "branch": {"type": "string"},
    "inputs": {"$ref": "#/$defs/hashes"},
    "outputs": {"$ref": "#/$defs/hashes"},
    "verify": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{"const": "pass"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]
      }
    },
    "gate": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["none", "human", "agent"]},
        "agent": {"type": "string"},
        "decision": {"enum": ["approve", "escalate", "reject"]}
      }
    },
    "summary": {"type": "string"},
    "questions": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "object"}
  },
  "$defs": {
    "hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  }
}
