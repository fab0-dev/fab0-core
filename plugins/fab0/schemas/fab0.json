{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fab0 project file (.fab0/fab0.yaml)",
  "type": "object",
  "required": ["schema", "repos", "people", "pipelines", "models"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "repos": {
      "type": "object",
      "required": ["home"],
      "propertyNames": {"$ref": "#/$defs/name", "not": {"enum": ["all", "task", "each-touched"]}},
      "additionalProperties": {
        "type": "object",
        "required": ["path", "github", "owner"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "owner": {"$ref": "#/$defs/name"},
          "key": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
          "base": {"type": "string", "minLength": 1}
        }
      }
    },
    "people": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "required": ["github"],
        "additionalProperties": false,
        "properties": {
          "github": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "tracker": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "github-projects"},
        "owner": {"type": "string"},
        "project": {"type": "integer", "minimum": 1},
        "fields": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "pipelines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "models": {
      "type": "object",
      "required": ["claude-code"],
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {"$ref": "#/$defs/name"},
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "profiles": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "object"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
  }
}
